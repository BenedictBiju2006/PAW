{
  "name": "paw",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "tsx --test tests/core.test.ts tests/a2ui.test.ts tests/tools.test.ts",
    "test:integration": "bash scripts/test-integration.sh",
    "test:browser": "bash scripts/test-browser.sh",
    "format": "prettier --write apps packages tests playwright.config.ts package.json README.md",
    "catalog:generate": "tsx scripts/generate-catalog.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "zod": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
