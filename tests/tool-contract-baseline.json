  {
    "id": "create_collection",
    "name": "create_collection",
    "description": "Create a typed collection with immutable fields.",
    "purpose": "Define structured persistent data for forms, tables and charts.",
    "keywords": [
      "collection",
      "create",
      "fields",
      "schema"
    ],
    "result": "Created collection and field schema.",
    "requiredPermissions": [
      "write"
    ],
    "sideEffects": "write",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "fields": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "date",
                  "enum"
                ]
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "options": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "required"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "workspaceId",
        "name",
        "fields"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "description": "Created collection and field schema.",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "data": {
          "description": "Created collection and field schema."
        },
        "error": {
          "type": "object"
        }
      },
      "required": [
        "ok"
      ]
    }
  },
