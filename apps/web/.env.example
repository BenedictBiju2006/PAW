NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Set behind a reverse proxy to the public app origin (no trailing slash).
# PAW_APP_ORIGIN=https://paw.example.com

# Server-only AI persistence (never prefix these with NEXT_PUBLIC_).
# Use a Supabase secret key or the legacy service-role key for the same project.
# SUPABASE_SECRET_KEY=your-server-only-supabase-secret
# SUPABASE_SERVICE_ROLE_KEY=legacy-server-only-key-alternative
# Generate once with: openssl rand -base64 32
# Keep this key stable and backed up separately from the database.
# PAW_CREDENTIAL_ENCRYPTION_KEY=base64-encoded-32-byte-key
# PAW_CREDENTIAL_KEY_VERSION=1
# Configurable supported Responses models; saved selections are validated with OpenAI.
# PAW_OPENAI_MODELS=gpt-4.1-mini,gpt-4.1
# Optional bounded execution controls:
# PAW_AGENT_MAX_STEPS=24
# PAW_AGENT_MAX_TOOL_CALLS=50
# PAW_AGENT_TIMEOUT_MS=120000
# PAW_AGENT_MAX_OUTPUT_TOKENS=8000
# PAW_AGENT_MAX_RESULT_CHARS=30000
# PAW_AGENT_MAX_CONTEXT_CHARS=160000
# Verified structured-tool models only; API availability is validated when saving.
# PAW_GOOGLE_MODELS=gemini-2.5-flash,gemini-2.5-pro
# PAW_GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
